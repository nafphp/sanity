{
  "name": "naf/sanity",
  "description": "A small monitoring helper with customizable actions",
  "type": "naf-plugin",
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.25",
    "phpunit/phpunit": "^13.0"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Naf\\Sanity\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Flo Knapp",
      "email": "office@florianknapp.de"
    }
  ],
  "minimum-stability": "stable",
  "suggest": {
    "naf/cli": "^v0.1.2"
  },
  "require": {},
  "scripts": {
    "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "style:fix": "@php vendor/bin/php-cs-fixer fix"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    }
  }
}
